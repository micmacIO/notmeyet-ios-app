{"openapi":"3.1.0","info":{"title":"Looksmaxxing API","description":"REST API for the Looksmaxxing platform: user wallets, selfie upload and facial analysis, AI transformation generation, credit plans and store webhooks. Most endpoints require a Firebase-issued JWT bearer token.","version":"v1"},"servers":[{"url":"http://localhost:45341","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Generations","description":"AI transformation generation orders"},{"name":"Plans","description":"Credit plans available for purchase"},{"name":"Transformations","description":"Discovery of AI transformations for a selfie"},{"name":"Webhooks: fal.ai","description":"fal.ai generation-result callbacks, authenticated by Ed25519 request signature headers (X-Fal-Webhook-*)"},{"name":"Admin","description":"Administrative plan and transformation management (requires the X-Admin-Key header)"},{"name":"Webhooks: RevenueCat","description":"RevenueCat store event callbacks (requires the X-Webhook-Key header)"},{"name":"Device tokens","description":"Push-notification device token registration"},{"name":"Selfies","description":"Selfie upload, retrieval and facial analysis"},{"name":"Users","description":"Current user's account and wallet"}],"paths":{"/api/v1/devices/token":{"put":{"tags":["Device tokens"],"summary":"Register a device token","description":"Associates an FCM device token with the authenticated user, replacing any existing token for the same device.","operationId":"registerToken","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterDeviceTokenRequest"}}},"required":true},"responses":{"200":{"description":"Token registered"},"400":{"description":"Invalid request body","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}},"401":{"description":"Missing or invalid bearer token","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProblemDetail"}}}}}},"delete":{"tags":["Device tokens"],"